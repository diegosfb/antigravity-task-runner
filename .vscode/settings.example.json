{
  "python.defaultInterpreterPath": "/path/to/python",
  "python.terminal.activateEnvironment": true,
  "python.condaPath": "/path/to/conda",
  "python-envs.terminal.autoActivationType": "command",
  "antigravity.rootPath": "./.agent/antigravity",
  "antigravity.workspaceProjectPath": "./",
  "antigravity.terminalName": "Antigravity Workflow",
  "antigravity.agentTerminalName": "Antigravity Agent",
  "antigravity.antigravityPath": "antigravity",
  "antigravity.antigravityArgs": "\"{agentFile}\"",
  "antigravity.scriptFallbackBaseUrl": "https://raw.githubusercontent.com/diegosfb/antigravity-workspace/main/scripts",
  "antigravity.configFallbackBaseUrl": "https://raw.githubusercontent.com/diegosfb/antigravity-workspace/main/config",
  "antigravity.autoUpdateClaudeMd": false,
  "antigravity.enableDebugLogging": true,
  "antigravity.customAgenticPlatformAddons": "/absolute/path/to/Agentic Addons",
  "antigravity.workflowsFolder": "/absolute/path/to/.antigravity",
  "antigravity.sopManualLink": "https://drive.google.com/uc?export=download&id=1P_dIVo6sHwymQeU71QdwOpIqHyVtdlX7",
  "antigravity.defaultGithubCodeReviewer": "@your-github-handle",
  "antigravity.jiraBaseUrl": "https://your-domain.atlassian.net/",
  "antigravity.jiraEmail": "you@example.com",
  "antigravity.jiraApiToken": "<set-locally-only>",
  "antigravity.createReleaseBranchWhenCreatingReleases": true,
  "antigravity.useAgentForGithubRepositoryManagement": false,
  "antigravity.agenticHarnessExecutionCommand": "claude",
  "antigravity.agenticHarnessExecutionCommands": [
    "claude",
    "claude --model claude-haiku-4-5-20251001",
    "codex",
    "opencode run",
    "opencode run -m ollama/qwen3-coder:30b",
    "opencode run -m ollama/qwen3-coder:480b-cloud",
    "opencode run -m ollama/gpt-oss:20-cloud"
  ],
  "antigravity.buildCommand": "npm run bump-version patch && npm run compile && vsce package",
  "postman.settings.dotenv-detection-notification-visibility": false
}
