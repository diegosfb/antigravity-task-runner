 flowchart TB
    classDef plan fill:#1E2761,stroke:#1E2761,color:#FFFFFF
    classDef build fill:#028090,stroke:#028090,color:#FFFFFF
    classDef release fill:#B85042,stroke:#B85042,color:#FFFFFF
    classDef live fill:#2C5F2D,stroke:#2C5F2D,color:#FFFFFF
    classDef artifact fill:#F3F4F6,stroke:#6B7280,stroke-dasharray:4 4,color:#374151

    PRODUCT["Product agent<br/><i>Vision, market research, benchmarking, user feedback</i>"]:::plan
    BA["BA agent<br/><i>Specs, features, acceptance criteria</i>"]:::plan
    ARCH["Architect agent<br/><i>architecture.md, ADRs, technical decomposition<br/>Data +dormant domain design subagents</i>"]:::plan
    UX["UX agent<br/><i>Design specs from ADR</i>"]:::plan
    PLANNER["Project planner agent<br/><i>Dependencies, sequencing, estimates</i>"]:::plan
    TASKS["Task backlog<br/><i>Sequenced, estimated, prioritized</i>"]:::artifact
    DEV["Developer agent<br/><i>FE / BE / Data subagents</i>"]:::build
    TEST["Test agent<br/><i>Writes and runs tests</i>"]:::build
    REDTEAM["Red-team agent<br/><i>Configured safe adversarial tests</i>"]:::build
    SECURITY["Security-check agent<br/><i>Blocking staged / branch assurance</i>"]:::release
    REVIEW["Code review agent<br/><i>Approves changes</i>"]:::release
    DEPLOY["Deployment agent<br/><i>CI/CD to production</i>"]:::release
    LIVE(["Live in production"]):::live

    PRODUCT -- "PRD (vision, goals)" --> BA
    BA -- specs --> ARCH
    ARCH -- ADR --> UX
    BA -- acceptance criteria --> PLANNER
    ARCH -- technical tasks --> PLANNER
    UX -- design tasks --> PLANNER
    PLANNER -- "ordered tasks + complexity / time estimates" --> TASKS
    TASKS -- sprint-ready tasks --> DEV
    DEV -- code --> TEST
    TEST -- "configured every-commit / every-PR run" --> REDTEAM
    REDTEAM -- "PASS or tracked findings" --> TEST
    TEST -- "full pass + resolved bugs" --> PLANNER
    PLANNER -- "items Done + acknowledgement" --> TEST
    TEST -- "PASS evidence + acknowledgement" --> DEV
    DEV -- "staged / branch security gate" --> SECURITY
    SECURITY -- PASS --> DEV
    DEV -- "hooks, commit, hooks, branch / PR" --> REVIEW
    TEST -. tests fail .-> DEV
    REVIEW -- PR --> DEPLOY
    REVIEW -. changes requested .-> DEV
    DEPLOY --> LIVE
    LIVE -. user feedback .-> PRODUCT
