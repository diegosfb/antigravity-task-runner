{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/vault-event.py --root . hook --platform codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/eval-capture.py --root . hook --platform codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/vault-event.py --root . hook --platform codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/eval-capture.py --root . hook --platform codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/vault-event.py --root . hook --platform codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/eval-capture.py --root . hook --platform codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/vault-event.py --root . hook --platform codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/eval-capture.py --root . hook --platform codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/vault-event.py --root . hook --platform codex",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 scripts/helper-scripts/eval-capture.py --root . hook --platform codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
