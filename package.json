{
  "name": "antigravity-task-runner",
  "displayName": "Task Runner",
  "description": "Browse and run Antigravity agents and workflows from the VS Code sidebar.",
  "version": "4.9.32",
  "publisher": "dsfb",
  "license": "MIT",
  "icon": "Resources/taskrunner.png",
  "repository": {
    "type": "git",
    "url": "https://example.com/dsfb/antigravity-task-runner"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:antigravityView",
    "onCommand:antigravity.openSettings",
    "onCommand:antigravity.openHelpDoc",
    "onCommand:antigravity.openAgent",
    "onCommand:antigravity.runAgent",
    "onCommand:antigravity.runWorkflow",
    "onCommand:antigravity.createFeatureBranch",
    "onCommand:antigravity.createPullRequest",
    "onCommand:antigravity.mergeBranchToMain",
    "onCommand:antigravity.checkoutMain",
    "onCommand:antigravity.setFeatureFlag",
    "onCommand:antigravity.agenticReviewOfMerge",
    "onCommand:antigravity.reviewPullRequest",
    "onCommand:antigravity.approvePullRequest",
    "onCommand:antigravity.feedbackOnPullRequest",
    "onCommand:antigravity.addJiraItem",
    "onCommand:antigravity.selectOrCreateJiraProject",
    "onCommand:antigravity.assignJiraItemToAgent",
    "onCommand:antigravity.takeJiraItemAssign",
    "onCommand:antigravity.completeJiraItem",
    "onCommand:antigravity.openSopManual",
    "onCommand:antigravity.openClaudeTerminal",
    "onCommand:antigravity.openOpenClaudeTerminal"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity.openSettings",
        "title": "Antigravity: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "antigravity.openHelpDoc",
        "title": "Antigravity: Open Help Doc",
        "icon": "$(book)"
      },
      {
        "command": "antigravity.runAgent",
        "title": "Antigravity: Run Agent"
      },
      {
        "command": "antigravity.openAgent",
        "title": "Antigravity: Open Agent"
      },
      {
        "command": "antigravity.runWorkflow",
        "title": "Antigravity: Run Workflow"
      },
      {
        "command": "antigravity.openClaudeTerminal",
        "title": "Antigravity: Open Claude Terminal"
      },
      {
        "command": "antigravity.openOllamaClaudeTerminal",
        "title": "Antigravity: Open Ollama Claude"
      },
      {
        "command": "antigravity.openOpenClaudeTerminal",
        "title": "Antigravity: Open OpenClaude Terminal"
      },
      {
        "command": "antigravity.setClaudeModel",
        "title": "Antigravity: Set Claude Model"
      },
      {
        "command": "antigravity.runLiteLLMOpenAI",
        "title": "Antigravity: Run liteLLM OpenAI"
      },
      {
        "command": "antigravity.buildProject",
        "title": "Antigravity: Build Project"
      },
      {
        "command": "antigravity.runProjectTests",
        "title": "Antigravity: Run Project Tests"
      },
      {
        "command": "antigravity.createClaudeMd",
        "title": "Antigravity: Create CLAUDE.md"
      },
      {
        "command": "antigravity.createAgentMd",
        "title": "Antigravity: Create AGENTS.md"
      },
      {
        "command": "antigravity.commitChanges",
        "title": "Antigravity: Commit Changes"
      },
      {
        "command": "antigravity.takeJiraItemAssign",
        "title": "Antigravity: Take Jira Item (Assign)"
      },
      {
        "command": "antigravity.assignJiraItemToAgent",
        "title": "Antigravity: Assign Jira Item to Agent"
      },
      {
        "command": "antigravity.selectOrCreateJiraProject",
        "title": "Antigravity: Select/Set Jira Project"
      },
      {
        "command": "antigravity.completeJiraItem",
        "title": "Antigravity: Jira Item Completed"
      },
      {
        "command": "antigravity.updateAgenticWorkspace",
        "title": "Antigravity: Update Agentic Workspace"
      },
      {
        "command": "antigravity.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "antigravity.openPath",
        "title": "Open"
      },
      {
        "command": "antigravity.addToProject",
        "title": "Add to project"
      },
      {
        "command": "antigravity.addToAgent",
        "title": "Add to .agent"
      },
      {
        "command": "antigravity.addToCustomSkills",
        "title": "Add to Custom Skills"
      },
      {
        "command": "antigravity.addToCustomAgents",
        "title": "Add to Custom Agents"
      },
      {
        "command": "antigravity.enablePlugin",
        "title": "Enable Plugin"
      },
      {
        "command": "antigravity.disablePlugin",
        "title": "Disable Plugin"
      },
      {
        "command": "antigravity.runClaudeAgent",
        "title": "Run Agent"
      },
      {
        "command": "antigravity.createFeatureBranch",
        "title": "Antigravity: Create Feature Branch"
      },
      {
        "command": "antigravity.createPullRequest",
        "title": "Antigravity: Create Pull Request"
      },
      {
        "command": "antigravity.mergeBranchToMain",
        "title": "Antigravity: Merge Branch to Main"
      },
      {
        "command": "antigravity.checkoutMain",
        "title": "Antigravity: Checkout Main (Branch work done)"
      },
      {
        "command": "antigravity.pullRemoteAndMerge",
        "title": "Antigravity: Pull Remote and Merge"
      },
      {
        "command": "antigravity.agenticReviewOfMerge",
        "title": "Antigravity: Agentic Review of Merge"
      },
      {
        "command": "antigravity.setFeatureFlag",
        "title": "Antigravity: Set Feature Flag for changes"
      },
      {
        "command": "antigravity.reviewPullRequest",
        "title": "Antigravity: Review a Pull Request"
      },
      {
        "command": "antigravity.approvePullRequest",
        "title": "Antigravity: Approve a Pull Request"
      },
      {
        "command": "antigravity.feedbackOnPullRequest",
        "title": "Antigravity: Feedback on Pull Request"
      },
      {
        "command": "antigravity.addJiraItem",
        "title": "Antigravity: Add Jira Item"
      },
      {
        "command": "antigravity.openSopManual",
        "title": "Antigravity: SOP Manual"
      },
      {
        "command": "antigravity.createRepoTag",
        "title": "Antigravity: Create Repo Tag"
      },
      {
        "command": "antigravity.backupCompress",
        "title": "Backup-Compress"
      },
      {
        "command": "antigravity.diffMergeSingle",
        "title": "DiffMerge"
      },
      {
        "command": "antigravity.diffMergeFiles",
        "title": "DiffMerge files"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravityContainer",
          "title": "Task Runner",
          "icon": "Resources/taskrunner.svg"
        }
      ]
    },
    "views": {
      "antigravityContainer": [
        {
          "id": "antigravityView",
          "name": "Tasky Runner v4.9.32",
          "icon": "Resources/taskrunner.svg"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "antigravity.backupCompress",
          "group": "7_modification@99"
        },
        {
          "command": "antigravity.diffMergeSingle",
          "when": "resourceScheme == file && !explorerResourceIsFolder && !listMultiSelection",
          "group": "7_modification@100"
        },
        {
          "command": "antigravity.diffMergeFiles",
          "when": "resourceScheme == file && !explorerResourceIsFolder && listMultiSelection",
          "group": "7_modification@101"
        }
      ],
      "view/title": [
        {
          "command": "antigravity.openSettings",
          "when": "view == antigravityView",
          "group": "navigation"
        },
        {
          "command": "antigravity.openHelpDoc",
          "when": "view == antigravityView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "antigravity.runAgent",
          "when": "view == antigravityView && viewItem == antigravityAgent",
          "group": "inline"
        },
        {
          "command": "antigravity.runClaudeAgent",
          "when": "view == antigravityView && viewItem == antigravityClaudeAgent",
          "group": "inline"
        },
        {
          "command": "antigravity.openAgent",
          "when": "view == antigravityView && viewItem == antigravityAgent",
          "group": "navigation"
        },
        {
          "command": "antigravity.copyPath",
          "when": "view == antigravityView && viewItem =~ /antigravityFolderItem/",
          "group": "navigation@1"
        },
        {
          "command": "antigravity.openPath",
          "when": "view == antigravityView && viewItem =~ /antigravityFolderItem/",
          "group": "navigation@2"
        },
        {
          "command": "antigravity.addToProject",
          "when": "view == antigravityView && viewItem =~ /antigravityFolderItem/",
          "group": "navigation@3"
        },
        {
          "command": "antigravity.addToCustomSkills",
          "when": "view == antigravityView && viewItem =~ /antigravityFolderItemSkill/",
          "group": "navigation@5"
        },
        {
          "command": "antigravity.addToCustomAgents",
          "when": "view == antigravityView && viewItem =~ /antigravityFolderItemAgent/",
          "group": "navigation@6"
        },
        {
          "command": "antigravity.enablePlugin",
          "when": "view == antigravityView && viewItem == claudePluginDisabled",
          "group": "navigation"
        },
        {
          "command": "antigravity.disablePlugin",
          "when": "view == antigravityView && viewItem == claudePluginEnabled",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Task Runner",
      "properties": {
        "antigravity.rootPath": {
          "type": "string",
          "default": "./.agent/antigravity",
          "description": "Path to the antigravity directory that contains agents/ and workflows/."
        },
        "antigravity.terminalName": {
          "type": "string",
          "default": "Antigravity Workflow",
          "description": "Terminal name used when running workflow scripts."
        },
        "antigravity.agentTerminalName": {
          "type": "string",
          "default": "Antigravity Agent",
          "description": "Terminal name used when running agents."
        },
        "antigravity.defaultGithubCodeReviewer": {
          "type": "string",
          "default": "@diegosfb",
          "description": "GitHub username suggested by default when creating a pull request."
        },
        "antigravity.buildCommand": {
          "type": "string",
          "default": "",
          "description": "Command used to build the solution (e.g. npm run build, make, ./gradlew build)."
        },
        "antigravity.projectTestingCommand": {
          "type": "string",
          "default": "",
          "description": "Command used to run the project's test suite (e.g. npm test, pytest, go test ./...)."
        },
        "antigravity.antigravityPath": {
          "type": "string",
          "default": "antigravity",
          "description": "Path to the Antigravity executable for running agents."
        },
        "antigravity.antigravityArgs": {
          "type": "string",
          "default": "\"{agentFile}\"",
          "description": "Arguments template for Antigravity. Supports {agent} and {agentFile} placeholders."
        },
        "antigravity.scriptFallbackBaseUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/diegosfb/antigravity-workspace/main/scripts",
          "description": "Base URL used to download missing scripts when ./scripts/<name>.sh is not present. Supports GitHub blob URLs and raw GitHub base URLs."
        },
        "antigravity.configFallbackBaseUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/diegosfb/antigravity-workspace/main/config",
          "description": "Base URL used to download missing config files (e.g. DEV-settings.yaml, .env)."
        },
        "antigravity.jiraBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Jira base URL used for all Jira actions."
        },
        "antigravity.jiraEmail": {
          "type": "string",
          "default": "",
          "description": "Jira email used for all Jira actions."
        },
        "antigravity.jiraApiToken": {
          "type": "string",
          "default": "",
          "description": "Jira API token used for all Jira actions."
        },
        "antigravity.antigravityWorkspaceProject": {
          "type": "string",
          "default": "~/antigravity-workspace",
          "description": "Local folder path where the antigravity-workspace repo should be cloned and kept up to date."
        },
        "antigravity.workspaceProjectPath": {
          "type": "string",
          "default": "./",
          "description": "Path where workspace files are extracted and downloaded to. Relative paths are resolved from the project root."
        },
        "antigravity.workflowsFolder": {
          "type": "string",
          "default": "/Users/diego.brihuega/.gemini",
          "description": "Base folder used to resolve Claude workflows. The extension checks both <folder>/workflows/<name>/WORKFLOW.md and <folder>/<name>/WORKFLOW.md before falling back to bundled workflows."
        },
        "antigravity.sopManualLink": {
          "type": "string",
          "default": "https://drive.google.com/uc?export=download&id=1P_dIVo6sHwymQeU71QdwOpIqHyVtdlX7",
          "description": "Markdown URL used by the SOP Manual quick action."
        },
        "antigravity.autoUpdateClaudeMd": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, autocommit start will also run Claude to update CLAUDE.md."
        },
        "antigravity.createReleaseBranchWhenCreatingReleases": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, creating a repo release also creates, switches to, and pushes a release branch with the release name."
        },
        "antigravity.enableDebugLogging": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, debug logs are written to the Antigravity output channel."
        },
        "antigravity.useAgentForGithubRepositoryManagement": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, agent-driven flows are preferred for GitHub repository management tasks."
        },
        "antigravity.agenticHarnessExecutionCommand": {
          "type": "string",
          "default": "claude",
          "description": "Selected Agentic Harness execution command."
        },
        "antigravity.agenticHarnessExecutionCommands": {
          "type": "array",
          "default": [
            "claude",
            "claude --model claude-haiku-4-5-20251001",
            "codex",
            "opencode run",
            "opencode run -m ollama/qwen3-coder:30b",
            "opencode run -m ollama/qwen3-coder:480b-cloud",
            "opencode run -m ollama/gpt-oss:20-cloud"
          ],
          "items": {
            "type": "string"
          },
          "description": "Saved Agentic Harness execution commands offered on the Settings page."
        },
        "antigravity.lightAgenticHarnessExecutionCommand": {
          "type": "string",
          "default": "claude --model claude-haiku-4-5-20251001",
          "description": "Selected Light Agentic Harness execution command."
        },
        "antigravity.lightAgenticHarnessExecutionCommands": {
          "type": "array",
          "default": [
            "claude --model claude-haiku-4-5-20251001",
            "opencode run -m ollama/qwen3-coder:30b",
            "gemini"
          ],
          "items": {
            "type": "string"
          },
          "description": "Saved Light Agentic Harness execution commands offered on the Settings page."
        },
        "antigravity.claudeSetupGithub": {
          "type": "string",
          "default": "",
          "description": "GitHub repo URL for Claude agentic setup."
        },
        "antigravity.geminiSetupGithub": {
          "type": "string",
          "default": "",
          "description": "GitHub repo URL for Gemini agentic setup."
        },
        "antigravity.codexSetupGithub": {
          "type": "string",
          "default": "",
          "description": "GitHub repo URL for Codex agentic setup."
        },
        "antigravity.customAgenticPlatformAddons": {
          "type": "string",
          "default": "",
          "description": "Path to a custom agentic platform addons directory shown in the folder section."
        }
      }
    }
  },
  "files": [
    "out/**",
    "Resources/**",
    "package.json",
    "LICENSE",
    "Project Level AGENT.md Guidelines.txt",
    "routerconfig.example.json",
    "src/commit-push-tag.sh",
    "src/run-claude-workflow.sh",
    "src/Switch-ClaudeCode-Model.sh",
    "src/autocommit_changes.sh",
    "src/autocommit_revert.sh",
    "src/init-repo.sh",
    "src/git_remote_fallback.sh",
    "src/create_feature_branch.sh",
    "src/create_pull_requrest.sh",
    "src/infer_jira_issue_link.js",
    "src/merge_branch_to_main.sh",
    "src/checkout_branch.sh",
    "src/pull_remote_and_merge.sh",
    "src/update-agent-setup.sh",
    "src/update-agentic-workspace.sh",
    "src/workspace-setup.sh",
    "Knowhow/Antigravity workflows/create_feature_branch/WORKFLOW.md",
    "Knowhow/Antigravity workflows/approve_pull_request/WORKFLOW.md"
  ],
  "scripts": {
    "compile": "node node_modules/typescript/lib/tsc.js -p ./",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.js\"",
    "test": "npm run compile && node --test tests/*.test.js",
    "create-release": "bash scripts/create-release.sh",
    "sync-view-name": "node src/sync-view-name.js",
    "version": "node src/sync-view-name.js",
    "bump-version": "./scripts/bump-version.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.98.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2"
  }
}
