{"id":"workflow-happy-path","description":"The complete approved SDLC follows the documented agent order, produces every core artifact, crosses every blocking gate, and returns production feedback to product discovery.","required_agent_sequence":["product-agent","ba-agent","architect-agent","architecture-review-agent","project-planner-agent","test-agent","developer-agent","test-agent","spec-validation-agent","documentation-agent","security-check-agent","code-review-agent","project-planner-agent","deployment-agent","product-agent"],"required_artifacts":["prd","specs","architecture-doc","adrs","technical-tasks","architecture-review","implementation-plan","task-backlog","per-task-execution-handoff","test-plan","test-scripts","source-code","pass-fail","conformance-report","documented-revision","approved-pr","live-release"],"required_handoffs":["product-agent:prd:ba-agent","ba-agent:specs:architect-agent","architect-agent:architecture-doc:architecture-review-agent","architecture-review-agent:architecture-review:project-planner-agent","project-planner-agent:per-task-execution-handoff:test-agent","test-agent:test-plan:developer-agent","developer-agent:source-code:test-agent","test-agent:pass-fail:spec-validation-agent","spec-validation-agent:conformance-report:documentation-agent","documentation-agent:documented-revision:security-check-agent","security-check-agent:pass:code-review-agent","code-review-agent:approved-pr:project-planner-agent","code-review-agent:approved-pr:deployment-agent","deployment-agent:live-release:product-agent"],"required_gates":["product-validation:go","architecture-review:approved","development:go","test-run:pass","spec-conformance:conformant","security-check:pass","code-review:approved","pr-acceptance:go","deployment:go","post-deploy-verification:pass"],"expected_outcome":"verified-live-release","tags":["critical","full-flow","happy-path"]}
{"id":"workflow-conditional-ux","description":"User-facing scope activates UX before architecture, returns design requirements to BA, and makes UX artifacts available to reconciled specs and planning.","required_agent_sequence":["ba-agent","ux-agent","ba-agent","architect-agent","project-planner-agent"],"required_artifacts":["ux-designs","design-requirements-feedback","specs","task-backlog"],"required_handoffs":["ba-agent:specs:ux-agent","ux-agent:design-requirements-feedback:ba-agent","ux-agent:ux-designs:ba-agent","ba-agent:specs:architect-agent","ba-agent:specs:project-planner-agent"],"expected_outcome":"ux-reconciled","tags":["conditional","ux","requirements"]}
{"id":"workflow-architecture-rework","description":"A rejected architecture returns to the architect and cannot reach planning until the reviewer approves the revised package.","required_agent_sequence":["architect-agent","architecture-review-agent","architect-agent","architecture-review-agent","project-planner-agent"],"required_artifacts":["architecture-doc","adrs","architecture-review"],"required_handoffs":["architecture-review-agent:rework:architect-agent","architecture-review-agent:architecture-review:project-planner-agent"],"required_gates":["architecture-review:rework","architecture-review:approved"],"expected_outcome":"architecture-approved","tags":["architecture","return-path","blocking-gate"]}
{"id":"workflow-test-failure-loop","description":"A failing test run returns diagnostics to development and repeats verification before conformance review.","required_agent_sequence":["test-agent","developer-agent","test-agent","developer-agent","test-agent","spec-validation-agent"],"required_artifacts":["test-plan","test-scripts","source-code","pass-fail"],"required_handoffs":["test-agent:failure-diagnostics:developer-agent","developer-agent:source-code:test-agent","test-agent:pass-fail:spec-validation-agent"],"required_gates":["test-run:fail","test-run:pass"],"expected_outcome":"tests-passed-after-fix","tags":["testing","return-path","tdd"]}
{"id":"workflow-configured-red-team","description":"A configured adversarial run occurs only through the test agent and returns a pass or tracked findings before deterministic verification completes.","required_agent_sequence":["test-agent","red-team-agent","test-agent"],"required_artifacts":["red-team-findings","pass-fail"],"required_handoffs":["test-agent:adversarial-scope:red-team-agent","red-team-agent:red-team-findings:test-agent"],"required_gates":["safe-ephemeral-target:confirmed","red-team:completed"],"expected_outcome":"adversarial-results-triaged","tags":["conditional","red-team","security"]}
{"id":"workflow-spec-drift-loop","description":"Spec drift returns to development and must become conformant before documentation starts.","required_agent_sequence":["spec-validation-agent","developer-agent","test-agent","spec-validation-agent","documentation-agent"],"required_artifacts":["conformance-report","source-code","pass-fail","documented-revision"],"required_handoffs":["spec-validation-agent:drift:developer-agent","developer-agent:source-code:test-agent","test-agent:pass-fail:spec-validation-agent","spec-validation-agent:conformance-report:documentation-agent"],"required_gates":["spec-conformance:drift","test-run:pass","spec-conformance:conformant"],"expected_outcome":"drift-resolved","tags":["conformance","return-path"]}
{"id":"workflow-spec-gap-loop","description":"A specification gap returns to BA and the reconciled specification traverses architecture and planning before implementation resumes.","required_agent_sequence":["spec-validation-agent","ba-agent","architect-agent","architecture-review-agent","project-planner-agent","test-agent"],"required_artifacts":["conformance-report","specs","architecture-review","implementation-plan","task-backlog"],"required_handoffs":["spec-validation-agent:spec-gap:ba-agent","ba-agent:specs:architect-agent","architecture-review-agent:architecture-review:project-planner-agent","project-planner-agent:per-task-execution-handoff:test-agent"],"required_gates":["spec-conformance:spec-gap","architecture-review:approved","development:go"],"expected_outcome":"spec-gap-resolved","tags":["requirements","return-path","replanning"]}
{"id":"workflow-security-failure-loop","description":"A blocking security-check failure returns to development and prevents code review until the branch diff passes.","required_agent_sequence":["security-check-agent","developer-agent","test-agent","spec-validation-agent","documentation-agent","security-check-agent","code-review-agent"],"required_artifacts":["source-code","pass-fail","conformance-report","documented-revision"],"required_handoffs":["security-check-agent:fail:developer-agent","developer-agent:source-code:test-agent","documentation-agent:documented-revision:security-check-agent","security-check-agent:pass:code-review-agent"],"required_gates":["security-check:fail","test-run:pass","spec-conformance:conformant","security-check:pass"],"expected_outcome":"security-findings-resolved","tags":["security","return-path","blocking-gate"]}
{"id":"workflow-review-change-loop","description":"Requested code-review changes return to development and repeat verification, conformance, documentation, and security checks before approval.","required_agent_sequence":["code-review-agent","developer-agent","test-agent","spec-validation-agent","documentation-agent","security-check-agent","code-review-agent","project-planner-agent"],"required_artifacts":["change-requests","source-code","pass-fail","conformance-report","documented-revision","approved-pr"],"required_handoffs":["code-review-agent:change-requests:developer-agent","developer-agent:source-code:test-agent","test-agent:pass-fail:spec-validation-agent","spec-validation-agent:conformance-report:documentation-agent","documentation-agent:documented-revision:security-check-agent","security-check-agent:pass:code-review-agent","code-review-agent:approved-pr:project-planner-agent"],"required_gates":["code-review:changes-requested","test-run:pass","spec-conformance:conformant","security-check:pass","code-review:approved","pr-acceptance:go"],"expected_outcome":"pr-approved-after-changes","tags":["review","return-path"]}
{"id":"workflow-sequential-tasks","description":"The planner dispatches the next dependency-ordered task only after the previous task PR is accepted.","required_agent_sequence":["project-planner-agent","test-agent","developer-agent","test-agent","spec-validation-agent","documentation-agent","security-check-agent","code-review-agent","project-planner-agent","test-agent","developer-agent","test-agent","spec-validation-agent","documentation-agent","security-check-agent","code-review-agent","project-planner-agent"],"required_artifacts":["task-backlog","per-task-execution-handoff","test-plan","test-scripts","source-code","pass-fail","conformance-report","documented-revision","approved-pr"],"required_handoffs":["project-planner-agent:task-1:test-agent","code-review-agent:task-1-approved-pr:project-planner-agent","project-planner-agent:task-2:test-agent","code-review-agent:task-2-approved-pr:project-planner-agent"],"required_gates":["task-1:pr-accepted","task-1:done","task-2:dispatched","task-2:pr-accepted","task-2:done"],"expected_outcome":"all-tasks-accepted","tags":["critical","sequencing","one-branch-one-pr"]}
